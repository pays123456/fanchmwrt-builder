# 目标/子目标/设备
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_glinet_gl-mt3600be=y

# 镜像
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_IMAGES_GZIP=y

# 包管理器：fanchmwrt 25.12 通常用 apk；若 source 实际是 opkg，改开 opkg、注释 apk
CONFIG_PACKAGE_apk-mbedtls=y
# CONFIG_PACKAGE_opkg=y

# 基础路由/防火墙/IPv6
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_odhcp6c=y

# 设备相关驱动（若 backport 的 filogic.mk 已通过 DEVICE_PACKAGES 带入，这里可省）
CONFIG_PACKAGE_mt7987-2p5g-phy-firmware=y
CONFIG_PACKAGE_kmod-mt7990-firmware=y
CONFIG_PACKAGE_kmod-hwmon-pwmfan=y
CONFIG_PACKAGE_kmod-usb3=y

# 管理：SSH + LuCI（fanchmwrt 用 ucode 版 Luci，包名以 source 菜单为准）
CONFIG_PACKAGE_openssh-server=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y

# 中文：
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
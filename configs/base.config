# ===== 目标平台 =====
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_glinet_gl-mt3600be=y

# ===== 镜像 =====
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_IMAGES_GZIP=y

# ===== 包管理器：25.12 apk =====
CONFIG_PACKAGE_apk-mbedtls=y

# ===== Fanchm 新控制台 fwx（与 OAF 二选一，别都堆） =====
CONFIG_PACKAGE_luci-app-fwx-appfilter=y
CONFIG_PACKAGE_luci-app-fwx-dashboard=y
CONFIG_PACKAGE_luci-app-fwx-dashboard-setting=y
CONFIG_PACKAGE_luci-app-fwx-feature=y
CONFIG_PACKAGE_luci-app-fwx-macfilter=y
CONFIG_PACKAGE_luci-app-fwx-network=y
CONFIG_PACKAGE_luci-app-fwx-record=y
CONFIG_PACKAGE_luci-app-fwx-resources=y
CONFIG_PACKAGE_luci-app-fwx-system=y
CONFIG_PACKAGE_luci-app-fwx-user=y
# 若 source 另有单入口再开：CONFIG_PACKAGE_luci-app-fanchm=y
# 主题只留一个实际存在的；按 feeds 二选一
CONFIG_PACKAGE_luci-theme-fanchmwrt=y
# CONFIG_PACKAGE_luci-theme-fanchm=y

# ===== LuCI 基础+中文（apk 体系，不写 opkg 旧库） =====
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# ===== 网络/防火墙/DNS（25.12 nft 为主，可去 iptables-nft） =====
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_pppoe-discovery=y
CONFIG_PACKAGE_uhttpd=y
# fullcone 按需；source 无此包 defconfig 会自动去掉
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-fullcone=y

# ===== IPv6 =====
CONFIG_PACKAGE_ipv6-support=y
CONFIG_PACKAGE_kmod-ip6tables=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y

# ===== 有线/2.5G（DEVICE_PACKAGES 已带 mt7987-2p5g 固件，这里只补驱动） =====
CONFIG_PACKAGE_kmod-mediatek-eth=y
# RTL8221B 外挂 2.5G：驱动不是固件，可保留；若 DTS 走内置只需保留 eth
CONFIG_PACKAGE_kmod-phy-realtek=y

# ===== Wi‑Fi 7 框架（固件由 DEVICE_PACKAGES 的 kmod-mt7990-firmware 带） =====
CONFIG_PACKAGE_kmod-mt76=y
CONFIG_PACKAGE_kmod-mt76-connac=y
CONFIG_PACKAGE_kmod-mt76-firmware=y
CONFIG_PACKAGE_wpad-openssl=y

# ===== PCI/USB 外设（usb3 已由 DEVICE_PACKAGES 带，不重复） =====
CONFIG_PACKAGE_kmod-pcie-mediatek=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y

# ===== 风扇/传感器（pwmfan 已由 DEVICE_PACKAGES 带，不重复） =====
CONFIG_PACKAGE_kmod-hwmon-core=y
CONFIG_PACKAGE_kmod-pwm-mediatek=y
CONFIG_PACKAGE_lm-sensors=y

# ===== 排障工具 =====
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_nload=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_openssh-client=y

# ===== 裁剪 =====
CONFIG_PACKAGE_luci-app-samba=n
CONFIG_PACKAGE_luci-app-ddns=n
CONFIG_PACKAGE_luci-app-openvpn=n
CONFIG_PACKAGE_luci-app-wireguard=n
CONFIG_PACKAGE_luci-app-statistics=n
CONFIG_PACKAGE_luci-app-upnp=n
CONFIG_PACKAGE_samba4-server=n
CONFIG_PACKAGE_ddns-scripts=n
CONFIG_PACKAGE_kmod-fs-ntfs=n
CONFIG_PACKAGE_kmod-fs-f2fs=n
CONFIG_PACKAGE_kmod-fs-xfs=n
CONFIG_PACKAGE_kmod-fs-btrfs=n
CONFIG_PACKAGE_kmod-bluetooth=n
CONFIG_PACKAGE_kmod-sdhci=n
CONFIG_PACKAGE_kmod-ata-core=n
CONFIG_PACKAGE_kmod-video-core=n
CONFIG_PACKAGE_kmod-sfp=n
CONFIG_PACKAGE_luci-i18n-base-zh-tw=n
